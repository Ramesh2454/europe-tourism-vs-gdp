      <aliases enabled='yes' />
      <column caption='GDP (paired)' datatype='real' default-format='c&quot;$&quot;#,##0' name='[GDP Paired]' role='measure' type='quantitative'>
        <calculation class='tableau' formula='// GDP only where trips exist, so r uses complete pairs&#10;IF NOT ISNULL([trips_per_1000]) THEN [gdp_pc_ppp] END' />
      </column>
      <column caption='H1 Verdict' datatype='string' name='[H1 Verdict]' role='measure' type='nominal'>
        <calculation class='tableau' formula='// BRD rule: r &gt;= 0.5 supported, 0.3-0.5 partly, &lt; 0.3 not&#10;IF [r GDP vs Trips] &gt;= 0.5 THEN &quot;Supported&quot;&#10;ELSEIF [r GDP vs Trips] &gt;= 0.3 THEN &quot;Partly supported&quot;&#10;ELSE &quot;Not supported&quot; END' />
      </column>
      <column caption='Keep Year' datatype='boolean' name='[Keep Year]' role='dimension' type='nominal'>
        <calculation class='tableau' formula='// Drops 2020-2022 unless the COVID Years parameter says include&#10;[Parameters].[COVID Years] = &quot;Include all years&quot; OR [covid_flag] = 0' />
      </column>
      <column caption='Trips per Resident' datatype='real' default-format='n0.00' name='[Trips per Resident]' role='measure' type='quantitative'>
        <calculation class='tableau' formula='// Average outbound trips per resident (easier to read than per 1,000)&#10;AVG([trips_per_1000]) / 1000' />
      </column>
      <column caption='Migrated Data' datatype='table' name='[__tableau_internal_object_id__].[Migrated Data]' role='measure' type='quantitative' />
      <column caption='COVID Year' datatype='integer' name='[covid_flag]' role='dimension' type='ordinal' />
      <column caption='GDP per Capita (PPP)' datatype='real' default-format='c&quot;$&quot;#,##0' name='[gdp_pc_ppp]' role='measure' type='quantitative' />
      <column caption='Destinations Reported' datatype='integer' default-format='n0' name='[n_destinations_reported]' role='measure' type='quantitative' />
      <column caption='Origin ISO3' datatype='string' name='[origin_iso3]' role='dimension' type='nominal' />
      <column caption='Country' datatype='string' name='[origin_name]' role='dimension' type='nominal' />
      <column caption='Outbound Arrivals' datatype='real' default-format='n#,##0' name='[outbound_arrivals]' role='measure' type='quantitative' />
      <column caption='Population' datatype='real' default-format='n#,##0' name='[population]' role='measure' type='quantitative' />
      <column caption='r (GDP vs trips)' datatype='real' default-format='n0.00' name='[r GDP vs Trips]' role='measure' type='quantitative'>
        <calculation class='tableau' formula='// Pearson r of GDP per capita vs trips per 1,000 across all country-years in view (H1)&#10;(AVG([GDP Paired] * [trips_per_1000]) - AVG([GDP Paired]) * AVG([trips_per_1000]))&#10;/ (STDEVP([GDP Paired]) * STDEVP([trips_per_1000]))' />
      </column>
      <column caption='Share within 1,000 km' datatype='real' default-format='p0.0%' name='[share_within_1000km]' role='measure' type='quantitative' />
      <column caption='Trips per 1,000 Residents' datatype='real' default-format='n#,##0' name='[trips_per_1000]' role='measure' type='quantitative' />
      <column caption='Year' datatype='integer' default-format='n0' name='[year]' role='dimension' type='ordinal' />
      <layout dim-ordering='alphabetic' measure-ordering='alphabetic' show-structure='true' />
      <semantic-values>
        <semantic-value key='[Country].[Name]' value='&quot;India&quot;' />
      </semantic-values>
